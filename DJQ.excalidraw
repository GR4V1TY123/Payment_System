      "seed": 1569399746,
      "version": 539,
      "versionNonce": 1034413279,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789221315505,
      "link": null,
      "locked": false,
      "text": "// create payment\nPOST /api/v1/payments\n{\n    sender_id,\n    receiver_id,\n    amount,\n    currency, //auto detect later\n    notes\n}\n\n// view a single payment record\nGET /api/v1/payments/:payment_id\n\n// create account\nPOST /api/v1/accounts\n\n// view account details\nGET /api/v1/accounts/:account_id\n\n// deposit\nPOST /api/v1/accounts/:account_id/deposit\n\n// view transaction history for a account\nGET /api/v1/accounts/:account_id/ledger",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// create payment\nPOST /api/v1/payments\n{\n    sender_id,\n    receiver_id,\n    amount,\n    currency, //auto detect later\n    notes\n}\n\n// view a single payment record\nGET /api/v1/payments/:payment_id\n\n// create account\nPOST /api/v1/accounts\n\n// view account details\nGET /api/v1/accounts/:account_id\n\n// deposit\nPOST /api/v1/accounts/:account_id/deposit\n\n// view transaction history for a account\nGET /api/v1/accounts/:account_id/ledger",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },

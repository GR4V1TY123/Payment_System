    {
      "id": "HwzGNk13cVVI6yPWKwYZK",
      "type": "text",
      "x": 1045.6101430257177,
      "y": 1641.5793285114653,
      "width": 530.99169921875,
      "height": 840,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,

      "updated": 1788011068172,
      "link": null,
      "locked": false,
      "text": "1. Payment -> for processing payment\n    \n    - payment_id (pkey)\n    - sender (fkey)\n    - receiver (fkey)\n    - amount\n    - currency\n    - status\n    - retries\n    - payment_method\n    - transaction_reference\n    - idempotency_key\n    - notes",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Payment -> for processing payment\n    \n    - payment_id (pkey)\n    - sender (fkey)\n    - receiver (fkey)\n    - amount\n    - currency\n    - status\n    - retries\n    - payment_method\n    - transaction_reference\n    - idempotency_key\n    - notes",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "Bcm7bi6Q0pOzg4ODKArI8",
      "type": "text",
      "x": -146.52029927571493,
      "y": 1464.0128703815828,
      "width": 428.65167236328125,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],

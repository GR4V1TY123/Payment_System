    {
      "id": "ABgFngnugvXxiVumcsZYE",
      "type": "text",
      "x": -28.763127644856695,
      "y": 406.9999381171332,
      "width": 483.9593505859375,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,

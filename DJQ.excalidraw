      "index": "b0x",
      "roundness": null,
      "seed": 1790751966,
      "version": 399,
      "versionNonce": 111848578,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787918617296,
      "link": null,
      "locked": false,
      "text": "2. Account -> account info\n    \n    - account_id (pkey)\n    - name\n    - email (uniq)\n    - currency\n    - status\n\n    //later\n    - account_no (like upi or smthn)",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Account -> account info\n    \n    - account_id (pkey)\n    - name\n    - email (uniq)\n    - currency\n    - status\n\n    //later\n    - account_no (like upi or smthn)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },

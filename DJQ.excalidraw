      "seed": 258295069,
      "version": 700,
      "versionNonce": 341820866,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787917811282,
      "link": null,
      "locked": false,
      "text": "1. System processes payment async\n2. System can retry a payment by exponential backoff\n3. failing payment are assigned to deadletter queue\n4. System handles concurrency through locks\n5. System maintains log of every operation\n\n6. Latency < 200ms\n7. CAP -> Strong consistency, low availability\n\n// later\n8. add modes for prefering consistency or availability",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. System processes payment async\n2. System can retry a payment by exponential backoff\n3. failing payment are assigned to deadletter queue\n4. System handles concurrency through locks\n5. System maintains log of every operation\n\n6. Latency < 200ms\n7. CAP -> Strong consistency, low availability\n\n// later\n8. add modes for prefering consistency or availability",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
